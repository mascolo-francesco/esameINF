# Copia questo file in .env.local.
# Connessione con l'utente lnc_app (permessi ridotti, vedi db/08_utente_app.sql)
DATABASE_URL=mysql://lnc_app:PASSWORD@HOST:PORTA/defaultdb?ssl-mode=REQUIRED
# Firma dei JWT di sessione: almeno 32 caratteri casuali
JWT_SEGRETO=
# Cifratura dei segreti TOTP: 64 cifre esadecimali (32 byte)
TOTP_CHIAVE=
